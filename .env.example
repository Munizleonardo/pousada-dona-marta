# E-mail da pousada usado para enviar (e receber) as solicitações de reserva.
GMAIL_USER=resid.marta@gmail.com

# Senha de app do Gmail (16 caracteres, NÃO é a senha normal da conta).
# Como gerar:
#   1. Entre em https://myaccount.google.com com a conta acima
#   2. Ative "Verificação em duas etapas" (Segurança > Verificação em duas etapas)
#   3. Volte em Segurança > "Senhas de app", crie uma nova (app: "Mail")
#   4. Copie a senha de 16 caracteres gerada e cole abaixo, sem espaços
GMAIL_APP_PASSWORD=
